{
  "name": "dayboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint \"scripts/**/*.ts\" \"tests/**/*.ts\" \"src/**/*.ts\" \"src/**/*.tsx\" \"middleware.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/phase0 tests/unit",
    "test:spec": "vitest run tests/phase0",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx scripts/check-supabase.ts && vitest run tests/integration",
    "test:e2e": "playwright test",
    "inventory": "tsx scripts/generate-acceptance-inventory.ts",
    "phase0:report": "tsx scripts/phase0-report.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "check:release-secrets": "tsx scripts/check-release-secrets.ts",
    "uat:preflight": "tsx scripts/uat-preflight.ts",
    "db:push:cloud": "tsx scripts/db-push-cloud.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "seed:owner": "tsx scripts/seed-owner-defaults.ts",
    "setup:cloud": "tsx scripts/db-push-cloud.ts && tsx scripts/bootstrap-owner.ts && tsx scripts/uat-preflight.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}