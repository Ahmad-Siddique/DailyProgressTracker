# =============================================================================
# Dayboard — copy to `.env.local`
# Supabase Dashboard → Project Settings → API (Publishable + Secret keys)
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_here

# Server / tests only — no NEXT_PUBLIC_ prefix
SUPABASE_SECRET_KEY=sb_secret_paste_here

# Database password (Dashboard → Settings → Database) — for pnpm db:push:cloud only
# SUPABASE_DB_PASSWORD=

# Optional server alias (same URL as above)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy JWT keys still work if your project has not migrated:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- App auth (required) ---
# Must match public.app_singleton.allowed_owner_email (db push / seed.sql).
ALLOWED_OWNER_EMAIL=you@yourdomain.com
# Local Supabase tests: owner@dayboard.test (see supabase/seed.sql)
# Optional login footer hint (public, not a secret):
# NEXT_PUBLIC_OWNER_EMAIL_HINT=owner@dayboard.test

# --- AI (optional) ---
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=model-id-1,model-id-2
OPENROUTER_REQUIRE_ZDR=false
NEXT_PUBLIC_OPENROUTER_REQUIRE_ZDR=
AI_TURN_SECRET=generate-a-long-random-string
APP_ORIGIN=http://localhost:3000

# --- E2E (optional) ---
# E2E_OWNER_PASSWORD=
# E2E_WRONG_EMAIL=

# --- Tests ---
# SUPABASE_SKIP=1
# INTEGRATION_RESET=1   # wipe auth users before integration tests (destructive)